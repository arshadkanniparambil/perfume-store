# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API and Project Settings → Database).
# .env.local is git-ignored: never commit real keys.

# ---- Used by the website (server-side only) --------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# The anon / publishable key. It is safe for public reads because Row Level
# Security limits what it can see. Do NOT put the service-role key here: the
# app refuses to start if you do.
SUPABASE_ANON_KEY=

# ---- Used only by scripts on your computer / CI ----------------------------
# Postgres connection string, used by `npm run db:seed`. It contains the
# database password, so it must never be exposed to the browser or added to
# your hosting provider's public/client environment.
DATABASE_URL=

# Optional: a throwaway Postgres server for `npm run test:db`. The tests
# create and drop their own temporary database on it.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
